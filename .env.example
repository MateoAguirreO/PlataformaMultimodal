# Copiar a .env y completar. docker compose lo lee solo.

# Verificacion jr/senior con Gemini (opcional; sin ella todo lo demas funciona igual)
GEMINI_API_KEY=

# Administrador inicial: se crea solo si la base no tiene ningun admin.
# Si ADMIN_PASSWORD queda vacio se genera una contrasena aleatoria y se muestra UNA vez
# en el log del backend (docker compose logs backend). En ambos casos se pide cambiarla
# en el primer ingreso. Ya creado el admin, borra ADMIN_PASSWORD de aqui.
ADMIN_EMAIL=admin@plataforma.local
ADMIN_PASSWORD=

# Sesiones: minutos sin uso y horas maximas antes de pedir login de nuevo
SESION_INACTIVIDAD_MIN=30
SESION_MAX_HORAS=8

# Intentos de login por IP cada 15 min (con Docker Desktop todos los clientes pueden
# compartir IP: si hay muchos usuarios, subirlo)
LOGIN_MAX_POR_IP=20

# Produccion detras de HTTPS (Caddy, nginx): COOKIE_SECURE=true y TRUST_PROXY=1.
# Con http://localhost o una IP de la red sin HTTPS, COOKIE_SECURE debe quedar en false
# o el navegador no guarda la cookie de sesion.
COOKIE_SECURE=false
TRUST_PROXY=
